@page "/leads"
@rendermode InteractiveServer
@using NorthrailCRM.Models
@using NorthrailCRM.Services
@using NorthrailCRM.Components.Shared
@using Microsoft.JSInterop
@inject LeadService LeadService
@inject IJSRuntime JS
@inject ILogger<Leads> Logger

<PageTitle>Leads | Northrail CRM</PageTitle>

@if (isLoading)
{
    <div class="grid min-h-screen place-items-center bg-[#0B2140] text-sm text-white/60">Leads werden geladen ...</div>
}
else
{
    <div class="grid min-h-screen bg-[#0B2140] text-white lg:h-screen lg:min-h-0 lg:overflow-hidden lg:grid-cols-[232px_320px_minmax(0,1fr)]">
        <WorkspaceSidebar ActivePage="leads" />

        <aside class="max-h-[38vh] min-h-[220px] overflow-y-auto border-b border-white/10 bg-[#102849] lg:h-screen lg:min-h-0 lg:max-h-screen lg:border-b-0 lg:border-r">
            <header class="flex items-center justify-between border-b border-white/10 px-5 py-5">
                <div>
                    <p class="text-xs font-medium uppercase tracking-[0.16em] text-[#FF9A2E]">CRM / Vertrieb</p>
                    <h1 class="mt-1 text-xl font-semibold tracking-tight">Leads <span class="ml-1 text-sm font-normal text-white/45">@leads.Count</span></h1>
                </div>
                <button @onclick="NewLead" type="button" aria-label="Neuen Lead erfassen" title="Neuen Lead erfassen" class="grid size-9 place-items-center rounded-full bg-[#FF8C1A] text-[#0B2140] hover:bg-[#FF9A2E] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#FF8C1A]">
                    <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
                </button>
            </header>
            <div class="border-b border-white/10 p-4">
                <label class="flex items-center gap-2.5 rounded-lg border border-white/15 bg-[#0B2140] px-3 py-2.5 focus-within:border-[#FF8C1A]">
                    <svg class="size-4 shrink-0 text-white/45" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m16 16 4 4"/></svg>
                    <input @bind="searchTerm" @bind:event="oninput" placeholder="Firma oder Ansprechpartner suchen" class="w-full bg-transparent text-sm text-white outline-none placeholder:text-white/40" />
                </label>
                <div class="mt-4 flex items-center justify-between text-xs">
                    <span class="font-medium text-white/70">Gespeicherte Leads</span>
                    <span class="text-white/45">@FilteredLeads.Count() Ergebnisse</span>
                </div>
            </div>
            <nav aria-label="Gespeicherte Leads" class="divide-y divide-white/10">
                @foreach (var lead in FilteredLeads)
                {
                    var isSelected = selectedLead?.Id == lead.Id;
                    <button @key="lead.Id" @onclick="() => SelectLead(lead)" aria-pressed="@isSelected" class="flex w-full items-start gap-3 px-5 py-4 text-left transition-colors @(isSelected ? "bg-[#FF8C1A]/15" : "hover:bg-white/5")">
                        <span class="grid size-10 shrink-0 place-items-center rounded-full bg-white/10 text-xs font-semibold text-[#FFB45C]">@LeadInitials(lead.CompanyName)</span>
                        <span class="min-w-0 flex-1">
                            <span class="block truncate text-sm font-medium">@lead.CompanyName</span>
                            <span class="mt-1 block truncate text-xs text-white/60">@lead.FirstName @lead.LastName</span>
                            <span class="mt-1 block truncate text-[10px] text-white/40">@lead.Role</span>
                        </span>
                    </button>
                }
                @if (!FilteredLeads.Any())
                {
                    <p class="px-5 py-10 text-center text-sm text-white/50">@(leads.Count == 0 ? "Noch keine Leads gespeichert." : "Keine Leads gefunden.")</p>
                }
            </nav>
        </aside>

        <main class="min-w-0 overflow-y-auto bg-[#0B2140] p-3 sm:p-6 lg:min-h-0 lg:overflow-hidden lg:p-8">
            <EditForm Model="currentLead" OnValidSubmit="SaveLeadAsync" class="mx-auto flex max-w-[1440px] flex-col gap-3 lg:h-full lg:flex-row">
                <DataAnnotationsValidator />
                <article class="min-w-0 flex-1 rounded-[20px] bg-white px-5 py-6 text-[#102344] shadow-xl shadow-black/10 sm:px-8 sm:py-8 lg:h-full lg:max-h-full lg:overflow-y-auto lg:px-10">
                    <header class="flex flex-wrap items-start justify-between gap-4 border-b border-[#E4E8EE] pb-6">
                        <div>
                            <p class="text-xs font-medium uppercase tracking-[0.16em] text-[#E98200]">@(IsViewingLead ? "Gespeicherter Lead" : "Neuer Lead")</p>
                            <h2 class="mt-1 text-xl font-semibold">@(IsViewingLead ? currentLead.CompanyName : "Lead erfassen")</h2>
                            @if (IsViewingLead)
                            {
                                <p class="mt-1 text-sm text-[#738095]">Erfasst am @currentLead.CreatedAtUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</p>
                            }
                        </div>
                        @if (IsViewingLead)
                        {
                            <button @onclick="NewLead" type="button" class="inline-flex items-center gap-2 rounded-md border border-[#D9DFE7] px-3 py-2 text-sm font-medium text-[#40536D] hover:bg-[#F4F6F8] focus-visible:outline focus-visible:outline-2 focus-visible:outline-[#E98200]">
                                <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
                                Neuer Lead
                            </button>
                        }
                    </header>

                    @if (!string.IsNullOrWhiteSpace(statusMessage))
                    {
                        <p role="status" class="mt-5 rounded-md bg-[#E7F5ED] px-4 py-3 text-sm text-[#287348]">@statusMessage</p>
                    }
                    @if (!string.IsNullOrWhiteSpace(errorMessage))
                    {
                        <p role="alert" class="mt-5 rounded-md bg-[#FCEBE8] px-4 py-3 text-sm text-[#A34132]">@errorMessage</p>
                    }
                    <ValidationSummary class="mt-4 text-sm text-[#A34132]" />

                    <fieldset disabled="@IsViewingLead" class="min-w-0 disabled:opacity-90">
                        <section class="border-b border-[#E4E8EE] py-6">
                            <h3 class="text-sm font-semibold">Basisdaten &amp; Kundenprofil</h3>
                            <div class="mt-5 grid gap-4 sm:grid-cols-2">
                                <div class="sm:col-span-2">
                                    <label for="lead-company" class="block text-xs font-medium text-[#62728B]">Firmenname (EVU / Verlader) <span class="text-[#B4513A]">*</span></label>
                                    <InputText id="lead-company" @bind-Value="currentLead.CompanyName" maxlength="250" class="mt-1.5 w-full rounded-md border border-[#D9DFE7] px-3 py-2.5 text-sm outline-none focus:border-[#E98200]" />
                                    <ValidationMessage For="() => currentLead.CompanyName" class="mt-1 block text-xs text-[#A34132]" />
                                </div>
                                <div>
                                    <label for="lead-first-name" class="block text-xs font-medium text-[#62728B]">Vorname <span class="text-[#B4513A]">*</span></label>
                                    <InputText id="lead-first-name" @bind-Value="currentLead.FirstName" maxlength="100" class="mt-1.5 w-full rounded-md border border-[#D9DFE7] px-3 py-2.5 text-sm outline-none focus:border-[#E98200]" />
                                    <ValidationMessage For="() => currentLead.FirstName" class="mt-1 block text-xs text-[#A34132]" />
                                </div>
                                <div>
                                    <label for="lead-last-name" class="block text-xs font-medium text-[#62728B]">Nachname <span class="text-[#B4513A]">*</span></label>
                                    <InputText id="lead-last-name" @bind-Value="currentLead.LastName" maxlength="100" class="mt-1.5 w-full rounded-md border border-[#D9DFE7] px-3 py-2.5 text-sm outline-none focus:border-[#E98200]" />
                                    <ValidationMessage For="() => currentLead.LastName" class="mt-1 block text-xs text-[#A34132]" />
                                </div>
                                <div>
                                    <label for="lead-email" class="block text-xs font-medium text-[#62728B]">E-Mail</label>
                                    <InputText id="lead-email" @bind-Value="currentLead.Email" type="email" maxlength="320" class="mt-1.5 w-full rounded-md border border-[#D9DFE7] px-3 py-2.5 text-sm outline-none focus:border-[#E98200]" />
                                    <ValidationMessage For="() => currentLead.Email" class="mt-1 block text-xs text-[#A34132]" />
                                </div>
                                <div>
                                    <label for="lead-phone" class="block text-xs font-medium text-[#62728B]">Telefonnummer</label>
                                    <InputText id="lead-phone" @bind-Value="currentLead.PhoneNumber" maxlength="50" class="mt-1.5 w-full rounded-md border border-[#D9DFE7] px-3 py-2.5 text-sm outline-none focus:border-[#E98200]" />
                                </div>
                                <div class="sm:col-span-2">
                                    <label for="lead-role" class="block text-xs font-medium text-[#62728B]">Rolle des Leads <span class="text-[#B4513A]">*</span></label>
                                    <InputSelect id="lead-role" @bind-Value="currentLead.Role" class="mt-1.5 w-full rounded-md border border-[#D9DFE7] bg-white px-3 py-2.5 text-sm outline-none focus:border-[#E98200]">
                                        <option value="">Bitte auswählen</option>
                                        @foreach (var option in RoleOptions)
                                        {
                                            <option value="@option">@option</option>
                                        }
                                    </InputSelect>
                                    <ValidationMessage For="() => currentLead.Role" class="mt-1 block text-xs text-[#A34132]" />
                                </div>
                            </div>
                            <fieldset class="mt-5">
                                <legend class="text-xs font-medium text-[#62728B]">Sicherheitsbescheinigung (SiBe) vorhanden für</legend>
                                <div class="mt-2 grid grid-cols-4 gap-2 sm:grid-cols-6 lg:grid-cols-11">
                                    @foreach (var country in CountryOptions)
                                    {
                                        <label @key="country" class="flex cursor-pointer items-center gap-1.5 rounded border border-[#E4E8EE] px-2 py-2 text-xs text-[#40536D]">
                                            <input type="checkbox" checked="@currentLead.SafetyCertificates.Contains(country)" @onchange="() => ToggleValue(currentLead.SafetyCertificates, country)" class="size-3.5 accent-[#E98200]" />
                                            @country
                                        </label>
                                    }
                                </div>
                            </fieldset>
                        </section>

                        <section class="py-6">
                            <h3 class="text-sm font-semibold">Projektdetails &amp; Einsatzbereich</h3>
                            <div class="mt-5 grid gap-4 sm:grid-cols-2">
                                <div>
                                    <label for="lead-rental-model" class="block text-xs font-medium text-[#62728B]">Mietmodell</label>
                                    <InputSelect id="lead-rental-model" @bind-Value="currentLead.RentalModel" class="mt-1.5 w-full rounded-md border border-[#D9DFE7] bg-white px-3 py-2.5 text-sm outline-none focus:border-[#E98200]">
                                        <option value="">Bitte auswählen</option>
                                        @foreach (var option in RentalModelOptions)
                                        {
                                            <option value="@option">@option</option>
                                        }
                                    </InputSelect>
                                </div>
                                <div>
                                    <label for="lead-duration" class="block text-xs font-medium text-[#62728B]">Geplante Laufzeit</label>
                                    <InputSelect id="lead-duration" @bind-Value="currentLead.PlannedDuration" class="mt-1.5 w-full rounded-md border border-[#D9DFE7] bg-white px-3 py-2.5 text-sm outline-none focus:border-[#E98200]">
                                        <option value="">Bitte auswählen</option>
                                        @foreach (var option in DurationOptions)
                                        {
                                            <option value="@option">@option</option>
                                        }
                                    </InputSelect>
                                </div>
                                <div>
                                    <label for="lead-availability" class="block text-xs font-medium text-[#62728B]">Gewünschter Bereitstellungstermin</label>
                                    <InputDate id="lead-availability" @bind-Value="currentLead.DesiredAvailability" class="mt-1.5 w-full rounded-md border border-[#D9DFE7] bg-white px-3 py-2.5 text-sm outline-none focus:border-[#E98200]" />
                                </div>
                                <div>
                                    <label for="lead-mileage" class="block text-xs font-medium text-[#62728B]">Voraussichtliche Laufleistung pro Monat</label>
                                    <InputSelect id="lead-mileage" @bind-Value="currentLead.MonthlyMileage" class="mt-1.5 w-full rounded-md border border-[#D9DFE7] bg-white px-3 py-2.5 text-sm outline-none focus:border-[#E98200]">
                                        <option value="">Bitte auswählen</option>
                                        @foreach (var option in MileageOptions)
                                        {
                                            <option value="@option">@option</option>
                                        }
                                    </InputSelect>
                                </div>
                                <div class="sm:col-span-2">
                                    <label for="lead-route" class="block text-xs font-medium text-[#62728B]">Einsatzrelation / Strecke</label>
                                    <InputTextArea id="lead-route" @bind-Value="currentLead.Route" maxlength="500" rows="2" placeholder="z. B. Hamburg – München, Rotterdam – Verona via Brenner" class="mt-1.5 w-full resize-y rounded-md border border-[#D9DFE7] px-3 py-2.5 text-sm outline-none focus:border-[#E98200]" />
                                </div>
                            </div>
                        </section>
                    </fieldset>

                    <footer class="flex flex-wrap items-center justify-between gap-3 border-t border-[#E4E8EE] pt-5">
                        @if (IsViewingLead)
                        {
                            <p class="text-xs text-[#738095]">Gespeicherter Lead · Nr. @currentLead.Id</p>
                            <button @onclick="NewLead" type="button" class="rounded-md border border-[#D9DFE7] px-4 py-2.5 text-sm font-medium text-[#40536D] hover:bg-[#F4F6F8]">Neuen Lead erfassen</button>
                        }
                        else
                        {
                            <p class="text-xs text-[#738095]">Pflichtfelder sind mit * gekennzeichnet.</p>
                            <button type="submit" disabled="@isSaving" class="inline-flex items-center gap-2 rounded-md bg-[#E98200] px-4 py-2.5 text-sm font-semibold text-white hover:bg-[#C86F00] disabled:cursor-wait disabled:opacity-60">
                                @if (isSaving)
                                {
                                    <span>Wird gespeichert ...</span>
                                }
                                else
                                {
                                    <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M5 4h12l3 3v13H4V4h1z"/><path d="M8 4v6h8V4M8 20v-6h8v6"/></svg>
                                    <span>Lead speichern</span>
                                }
                            </button>
                        }
                    </footer>
                </article>
                <aside aria-label="Technische Fahrzeug-Anforderungen" class="min-w-0 rounded-[20px] bg-white text-[#102344] shadow-xl shadow-black/10 lg:h-full lg:max-h-full lg:w-80 lg:shrink-0 lg:overflow-y-auto">
                    <header class="border-b border-[#E4E8EE] px-5 py-5">
                        <p class="text-[10px] font-bold uppercase tracking-[0.16em] text-[#738095]">Leadprofil</p>
                        <h3 class="mt-1 text-sm font-semibold">Technische Anforderungen</h3>
                    </header>
                    <fieldset disabled="@IsViewingLead" class="space-y-5 p-5 disabled:opacity-90">
                        <div>
                            <label for="lead-traction" class="block text-xs font-medium text-[#62728B]">Traktionsart</label>
                            <InputSelect id="lead-traction" @bind-Value="currentLead.TractionType" class="mt-1.5 w-full rounded-md border border-[#D9DFE7] bg-white px-3 py-2.5 text-sm outline-none focus:border-[#E98200]">
                                <option value="">Bitte auswählen</option>
                                @foreach (var option in TractionOptions)
                                {
                                    <option value="@option">@option</option>
                                }
                            </InputSelect>
                        </div>
                        <div>
                            <label for="lead-locomotive-count" class="block text-xs font-medium text-[#62728B]">Gewünschte Anzahl an Loks</label>
                            <InputNumber id="lead-locomotive-count" @bind-Value="currentLead.DesiredLocomotiveCount" min="1" step="1" class="mt-1.5 w-full rounded-md border border-[#D9DFE7] bg-white px-3 py-2.5 text-sm outline-none focus:border-[#E98200]" />
                            <ValidationMessage For="() => currentLead.DesiredLocomotiveCount" class="mt-1 block text-xs text-[#A34132]" />
                        </div>
                        <div>
                            <label for="lead-platform" class="block text-xs font-medium text-[#62728B]">Gewünschte Baureihe / Plattform</label>
                            <InputSelect id="lead-platform" @bind-Value="currentLead.LocomotivePlatform" class="mt-1.5 w-full rounded-md border border-[#D9DFE7] bg-white px-3 py-2.5 text-sm outline-none focus:border-[#E98200]">
                                <option value="">Bitte auswählen</option>
                                @foreach (var option in PlatformOptions)
                                {
                                    <option value="@option">@option</option>
                                }
                            </InputSelect>
                        </div>
                        @if (currentLead.LocomotivePlatform == OtherPlatformOption)
                        {
                            <div>
                                <label for="lead-other-platform" class="block text-xs font-medium text-[#62728B]">Sonstige Baureihe / Plattform</label>
                                <InputText id="lead-other-platform" @bind-Value="currentLead.OtherPlatform" maxlength="250" class="mt-1.5 w-full rounded-md border border-[#D9DFE7] px-3 py-2.5 text-sm outline-none focus:border-[#E98200]" />
                            </div>
                        }
                        <fieldset>
                            <legend class="text-xs font-medium text-[#62728B]">Länderpakete / Korridore</legend>
                            <div class="mt-2 grid gap-2">
                                @foreach (var option in CorridorOptions)
                                {
                                    <label @key="option" class="flex cursor-pointer items-start gap-2 rounded border border-[#E4E8EE] px-3 py-2.5 text-xs text-[#40536D]">
                                        <input type="checkbox" checked="@currentLead.Corridors.Contains(option)" @onchange="() => ToggleValue(currentLead.Corridors, option)" class="mt-0.5 size-4 shrink-0 accent-[#E98200]" />
                                        <span>@option</span>
                                    </label>
                                }
                            </div>
                        </fieldset>
                        <fieldset>
                            <legend class="text-xs font-medium text-[#62728B]">Zugsicherungssysteme</legend>
                            <div class="mt-2 grid gap-2">
                                @foreach (var option in SafetySystemOptions)
                                {
                                    <label @key="option" class="flex cursor-pointer items-start gap-2 rounded border border-[#E4E8EE] px-3 py-2.5 text-xs text-[#40536D]">
                                        <input type="checkbox" checked="@currentLead.SafetySystems.Contains(option)" @onchange="() => ToggleValue(currentLead.SafetySystems, option)" class="mt-0.5 size-4 shrink-0 accent-[#E98200]" />
                                        <span>@option</span>
                                    </label>
                                }
                            </div>
                        </fieldset>
                        <fieldset>
                            <legend class="text-xs font-medium text-[#62728B]">Zusatzfeatures</legend>
                            <div class="mt-2 grid gap-2">
                                <label class="flex cursor-pointer items-start gap-2 rounded border border-[#E4E8EE] px-3 py-2.5 text-xs text-[#40536D]"><InputCheckbox @bind-Value="currentLead.RadioRemoteControl" class="mt-0.5 size-4 shrink-0 accent-[#E98200]" />Funkfernsteuerung</label>
                                <label class="flex cursor-pointer items-start gap-2 rounded border border-[#E4E8EE] px-3 py-2.5 text-xs text-[#40536D]"><InputCheckbox @bind-Value="currentLead.LastMileDiesel" class="mt-0.5 size-4 shrink-0 accent-[#E98200]" />Last-Mile-Diesel</label>
                                <label class="flex cursor-pointer items-start gap-2 rounded border border-[#E4E8EE] px-3 py-2.5 text-xs text-[#40536D]"><InputCheckbox @bind-Value="currentLead.MiddleCoupler" class="mt-0.5 size-4 shrink-0 accent-[#E98200]" />Mittelpufferkupplung</label>
                            </div>
                        </fieldset>
                    </fieldset>
                </aside>
            </EditForm>
        </main>
    </div>
}

@code {
    private const string OtherPlatformOption = "Sonstige (Freitext)";
    private static readonly string[] RoleOptions =
    [
        "Eisenbahnverkehrsunternehmen (EVU) – Güterverkehr",
        "Eisenbahnverkehrsunternehmen (EVU) – Personenfernverkehr",
        "Eisenbahnverkehrsunternehmen (EVU) – Personennahverkehr (SPNV)",
        "Werksbahn / Industriebetrieb",
        "Infrastrukturbetreiber / Bauzugunternehmen",
        "Anderer Vermieter (Sub-Leasing)"
    ];
    private static readonly string[] CountryOptions = ["DE", "AT", "CH", "NL", "PL", "CZ", "SK", "HU", "IT", "FR", "BE"];
    private static readonly string[] TractionOptions =
    [
        "Elektrolok – Mehrsystem (MS)",
        "Elektrolok – Wechselstrom (AC)",
        "Elektrolok – Gleichstrom (DC)",
        "Diesellok – Streckenlok",
        "Diesellok – Rangierlok",
        "Dual-Mode / Hybrid (z. B. Vectron Dual Mode, EuroDual)"
    ];
    private static readonly string[] PlatformOptions =
    [
        "Siemens Vectron (MS / AC / DM)",
        "Alstom/Bombardier Traxx (F140 MS, AC3, etc.)",
        "Stadler EuroDual / Euro4001",
        "Spezifische Rangierloks (z. B. Vossloh G1206 / G6)",
        OtherPlatformOption
    ];
    private static readonly string[] CorridorOptions =
    [
        "DACH-NL (Deutschland, Österreich, Schweiz, Niederlande)",
        "DACH-PL-CZ-SK-HU (Osteuropa-Korridor)",
        "DE-AT-IT (Brenner-Korridor)",
        "Reines Inlandszertifikat (z. B. nur DE / nur FR)"
    ];
    private static readonly string[] SafetySystemOptions =
    [
        "ETCS (Baseline 2 / Baseline 3)",
        "PZB / LZB (Deutschland/Österreich)",
        "Integra-Signum / ZUB (Schweiz)",
        "ATB (Niederlande)",
        "Mirel (Osteuropa)",
        "SCMT (Italien)"
    ];
    private static readonly string[] RentalModelOptions =
    [
        "Full-Service-Leasing (Instandhaltung komplett inklusive)",
        "Dry-Lease (Reine Fahrzeuggestellung, Kunde kümmert sich um ECM/Wartung)",
        "Spot-Lease (Kurzzeitmiete für Baustellen, Peak-Abdeckung oder Ausfälle)"
    ];
    private static readonly string[] DurationOptions =
    [
        "Spot / Kurzfristig (1 bis 3 Monate)",
        "Mittelfristig (4 bis 12 Monate)",
        "Langfristig (12 bis 36 Monate)",
        "Strategisch (36 bis 60+ Monate)"
    ];
    private static readonly string[] MileageOptions =
    [
        "Bis 8.000 km (geringe Auslastung/Rangieren)",
        "8.000 – 15.000 km (Standard Güterverkehr)",
        "Mehr als 15.000 km (Intensiver Umlauf/Personenverkehr)"
    ];

    private IReadOnlyList<Lead> leads = [];
    private Lead currentLead = new();
    private Lead? selectedLead;
    private string searchTerm = string.Empty;
    private string? statusMessage;
    private string? errorMessage;
    private bool isLoading = true;
    private bool isSaving;

    private bool IsViewingLead => selectedLead is not null;

    private IEnumerable<Lead> FilteredLeads => leads.Where(lead =>
        $"{lead.CompanyName} {lead.FirstName} {lead.LastName} {lead.Email} {lead.Role}"
            .Contains(searchTerm, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        leads = await LeadService.GetLeadsAsync();
        isLoading = false;
    }

    private void SelectLead(Lead lead)
    {
        selectedLead = lead;
        currentLead = lead;
        statusMessage = null;
        errorMessage = null;
    }

    private void NewLead()
    {
        selectedLead = null;
        currentLead = new Lead();
        statusMessage = null;
        errorMessage = null;
    }

    private async Task SaveLeadAsync()
    {
        isSaving = true;
        statusMessage = null;
        errorMessage = null;
        try
        {
            var id = await LeadService.CreateLeadAsync(currentLead);
            leads = await LeadService.GetLeadsAsync();
            selectedLead = leads.FirstOrDefault(lead => lead.Id == id);
            if (selectedLead is not null)
            {
                currentLead = selectedLead;
            }

            statusMessage = "Der Lead wurde gespeichert.";
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Could not save lead for company {CompanyName}.", currentLead.CompanyName);
            errorMessage = "Der Lead konnte nicht gespeichert werden. Bitte versuchen Sie es erneut.";
        }
        finally
        {
            isSaving = false;
        }
    }

    private static void ToggleValue(List<string> values, string value)
    {
        if (!values.Remove(value))
        {
            values.Add(value);
        }
    }

    private static string LeadInitials(string companyName)
    {
        var name = companyName.Trim();
        return name.Length == 0 ? "?" : name[..Math.Min(2, name.Length)].ToUpperInvariant();
    }
}