@page "/fahrzeuge"
@rendermode InteractiveServer
@using NorthrailCRM.Models
@using NorthrailCRM.Services
@using NorthrailCRM.Components.Shared
@using Microsoft.JSInterop
@inject VehicleService VehicleService
@inject IJSRuntime JS

<PageTitle>Fahrzeuge | Northrail CRM</PageTitle>

@if (isLoading)
{
    <div aria-busy="true" class="vehicles-loading-layout grid min-h-screen bg-[#0B2140] text-white lg:h-screen lg:min-h-0 lg:overflow-hidden lg:grid-cols-[232px_350px_minmax(0,1fr)]">
        <aside aria-hidden="true" class="hidden flex-col border-r border-white/10 bg-[#0B2140] px-5 py-7 lg:flex">
            <div class="vehicles-loading-sheen mb-12 h-5 w-36 rounded"></div>
            <div class="vehicles-loading-sheen mb-5 h-3 w-20 rounded"></div>
            <div class="space-y-3">
                <div class="vehicles-loading-sheen h-10 rounded-full"></div>
                <div class="vehicles-loading-sheen h-10 rounded-full opacity-60"></div>
            </div>
            <div class="mt-auto flex items-center gap-3 border-t border-white/10 pt-5">
                <div class="vehicles-loading-sheen size-9 rounded-full"></div>
                <div class="flex-1 space-y-2"><div class="vehicles-loading-sheen h-3 w-28 rounded"></div><div class="vehicles-loading-sheen h-2.5 w-20 rounded opacity-60"></div></div>
            </div>
        </aside>

        <section aria-hidden="true" class="max-h-[55vh] min-h-[45vh] overflow-hidden border-b border-white/10 bg-[#102849] lg:h-screen lg:min-h-0 lg:max-h-screen lg:border-b-0 lg:border-r">
            <header class="border-b border-white/10 px-6 py-6">
                <div class="vehicles-loading-sheen h-3 w-28 rounded"></div>
                <div class="vehicles-loading-sheen mt-3 h-6 w-40 rounded"></div>
            </header>
            <div class="border-b border-white/10 p-4">
                <div class="vehicles-loading-sheen h-10 rounded-lg"></div>
                <div class="mt-5 flex justify-between"><div class="vehicles-loading-sheen h-3 w-20 rounded"></div><div class="vehicles-loading-sheen h-3 w-16 rounded"></div></div>
            </div>
            <div class="divide-y divide-white/10">
                @for (var row = 0; row < 8; row++)
                {
                    <div class="flex items-start gap-3 px-5 py-4">
                        <div class="vehicles-loading-sheen size-10 shrink-0 rounded-full"></div>
                        <div class="min-w-0 flex-1 space-y-2.5 pt-1"><div class="vehicles-loading-sheen h-3.5 w-3/4 rounded"></div><div class="vehicles-loading-sheen h-3 w-1/2 rounded opacity-60"></div></div>
                    </div>
                }
            </div>
        </section>

        <main aria-hidden="true" class="flex min-w-0 gap-3 bg-[#0B2140] p-3 sm:p-6 lg:min-h-0 lg:overflow-hidden lg:p-8">
            <div class="crm-contact-card vehicles-loading-card mx-auto flex min-h-0 min-w-0 max-h-[calc(100vh-2.5rem)] flex-1 gap-6 overflow-hidden rounded-[26px] bg-white p-6 shadow-xl sm:p-10 lg:h-full lg:max-h-full lg:p-12">
                <div class="min-w-0 flex-1">
                    <div class="flex items-center gap-5 border-b border-[#E4E8EE] pb-8">
                        <div class="vehicles-loading-sheen-light size-16 shrink-0 rounded-2xl"></div>
                        <div class="min-w-0 flex-1 space-y-3"><div class="vehicles-loading-sheen-light h-3 w-24 rounded"></div><div class="vehicles-loading-sheen-light h-6 w-2/3 rounded"></div><div class="vehicles-loading-sheen-light h-3.5 w-1/2 rounded"></div></div>
                    </div>
                    <div class="mt-8 border-t border-[#E4E8EE] pt-8">
                        <div class="vehicles-loading-sheen-light h-4 w-44 rounded"></div>
                        <div class="mt-6 grid gap-6 sm:grid-cols-2">
                            @for (var field = 0; field < 4; field++)
                            {
                                <div class="space-y-2"><div class="vehicles-loading-sheen-light h-3 w-20 rounded"></div><div class="vehicles-loading-sheen-light h-4 w-32 rounded"></div></div>
                            }
                        </div>
                    </div>
                </div>
            </div>
            <p role="status" class="sr-only">Fahrzeuge werden geladen.</p>
        </main>
    </div>
}
else
{
    <div class="vehicles-page-enter grid min-h-screen bg-[#0B2140] text-white lg:h-screen lg:min-h-0 lg:overflow-hidden lg:grid-cols-[232px_350px_minmax(0,1fr)]">
        <WorkspaceSidebar ActivePage="vehicles" />

        <section class="flex max-h-[55vh] min-h-[45vh] flex-col overflow-hidden border-b border-white/10 bg-[#102849] lg:h-screen lg:min-h-0 lg:max-h-screen lg:border-b-0 lg:border-r">
            <div class="shrink-0 bg-[#102849]">
            <header class="flex items-center justify-between border-b border-white/10 px-6 py-6">
                <div>
                    <p class="text-xs font-medium uppercase tracking-[0.16em] text-[#FF9A2E]">CRM / Fahrzeuge</p>
                    <h1 class="mt-1 text-xl font-semibold tracking-tight text-white">Fahrzeuge <span class="ml-1 text-sm font-normal text-white/45">@vehicles.Count</span></h1>
                </div>
            </header>

            <div class="border-b border-white/10 p-4">
                <label class="flex items-center gap-2.5 rounded-lg border border-white/15 bg-[#0B2140] px-3 py-2.5 focus-within:border-[#FF8C1A]">
                    <svg class="size-4 shrink-0 text-white/45" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m16 16 4 4"/></svg>
                    <input @bind="searchTerm" @bind:event="oninput" @bind:after="EnsureFilteredSelection" @onkeydown="HandleSearchKeyDown" placeholder="Fahrzeug, Gattung oder Mieter suchen" class="w-full bg-transparent text-sm text-white outline-none placeholder:text-white/40" />
                    <kbd class="hidden rounded border border-white/20 px-1.5 py-0.5 text-[10px] text-white/45 sm:inline">⌘ K</kbd>
                </label>
                <div role="group" aria-label="Fahrzeuge nach Status filtern" class="mt-3 grid grid-cols-3 gap-0.5 rounded-md border border-white/10 bg-white/[0.03] p-0.5">
                    <button type="button" @onclick="() => SetStatusFilter(VehicleStatusFilter.All)" aria-pressed="@(statusFilter == VehicleStatusFilter.All)" class="rounded px-2.5 py-1.5 text-[11px] font-medium transition-colors @(statusFilter == VehicleStatusFilter.All ? "bg-white/10 text-white/90" : "text-white/50 hover:text-white/80")">Alle</button>
                    <button type="button" @onclick="() => SetStatusFilter(VehicleStatusFilter.Rented)" aria-pressed="@(statusFilter == VehicleStatusFilter.Rented)" class="rounded px-2.5 py-1.5 text-[11px] font-medium transition-colors @(statusFilter == VehicleStatusFilter.Rented ? "bg-white/10 text-white/90" : "text-white/50 hover:text-white/80")">Vermietet</button>
                    <button type="button" @onclick="() => SetStatusFilter(VehicleStatusFilter.Available)" aria-pressed="@(statusFilter == VehicleStatusFilter.Available)" class="rounded px-2.5 py-1.5 text-[11px] font-medium transition-colors @(statusFilter == VehicleStatusFilter.Available ? "bg-white/10 text-white/90" : "text-white/50 hover:text-white/80")">Verfügbar</button>
                </div>
                <div class="mt-4 flex items-center justify-between text-xs">
                    <span class="font-medium text-white/70">@StatusFilterLabel</span>
                    <span class="text-white/45">@FilteredVehicles.Count() Ergebnisse</span>
                </div>
            </div>
            </div>

            <div @ref="vehicleList" role="listbox" aria-label="Fahrzeuge" class="crm-contact-list min-h-0 flex-1 divide-y divide-white/10 overflow-y-auto">
                @foreach (var vehicle in FilteredVehicles)
                {
                    var selected = SelectedVehicle?.Key == vehicle.Key;
                    <button @key="vehicle.Key" data-vehicle-key="@vehicle.Key" role="option" aria-selected="@selected" tabindex="@(selected ? 0 : -1)" @onclick="() => SelectVehicle(vehicle)" class="flex w-full items-start gap-3 px-5 py-4 text-left transition focus-visible:outline focus-visible:outline-2 focus-visible:outline-inset focus-visible:outline-[#FF8C1A] @(selected ? "bg-[#FF8C1A]/15" : "hover:bg-white/5")">
                        <span class="grid size-10 shrink-0 place-items-center rounded-full bg-white/10 text-xs font-semibold text-[#FFB45C]">@Initials(vehicle)</span>
                        <span class="min-w-0 flex-1">
                            <span class="flex items-center justify-between gap-2">
                                <span class="truncate text-sm font-medium text-white">@vehicle.DisplayName</span>
                                @if (selected)
                                {
                                    <span class="size-1.5 shrink-0 rounded-full bg-[#FF8C1A]"></span>
                                }
                            </span>
                            <span class="mt-1 block truncate text-xs text-white/65">@vehicle.Subtitle</span>
                        </span>
                    </button>
                }
                @if (!FilteredVehicles.Any())
                {
                    <p class="px-5 py-10 text-center text-sm text-white/50">Keine Fahrzeuge gefunden.</p>
                }
            </div>
        </section>

        <main class="relative flex min-w-0 bg-[#0B2140] p-3 sm:p-6 lg:min-h-0 lg:overflow-hidden lg:p-8">
            @if (SelectedVehicle is not null)
            {
                var currentContract = SelectedVehicle.CurrentContract;
                <div class="crm-contact-card min-h-0 min-w-0 max-h-[calc(100vh-2.5rem)] flex-1 overflow-y-auto rounded-[26px] bg-white px-6 py-8 text-[#102344] shadow-xl shadow-black/10 sm:px-10 lg:h-full lg:max-h-full lg:px-14 lg:py-12">
                    <div class="flex flex-wrap items-start justify-between gap-5 pb-8">
                        <div class="flex items-center gap-5">
                            <span class="grid size-16 place-items-center rounded-2xl bg-[#0B2140] text-xl font-semibold text-[#FF9A2E]">@Initials(SelectedVehicle)</span>
                            <div>
                                <p class="text-xs font-medium uppercase tracking-[0.16em] text-[#E98200]">Fahrzeugprofil</p>
                                <h2 class="mt-1 text-2xl font-semibold tracking-tight text-[#102344]">@SelectedVehicle.DisplayName</h2>
                                <p class="mt-1 text-sm text-[#62728B]">@SelectedVehicle.Subtitle</p>
                            </div>
                        </div>
                        <span class="rounded-full px-2.5 py-1 text-xs @(currentContract is null ? "bg-[#E7F5ED] text-[#287348]" : "bg-[#FFF3E0] text-[#9A5B00]")">@(currentContract is null ? "Verfügbar" : "Vermietet")</span>
                    </div>

                    <div role="tablist" aria-label="Fahrzeugprofil" class="flex gap-6 border-b border-[#E4E8EE]">
                        <button type="button" role="tab" id="vehicle-tab-overview" aria-controls="vehicle-tabpanel" aria-selected="@(activeProfileTab == VehicleProfileTab.Overview)" @onclick="() => activeProfileTab = VehicleProfileTab.Overview" class="-mb-px border-b-2 pb-3 text-sm transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#E98200] @(activeProfileTab == VehicleProfileTab.Overview ? "border-[#FF8C1A] font-semibold text-[#102344]" : "border-transparent text-[#738095] hover:text-[#102344]")">Übersicht</button>
                        <button type="button" role="tab" id="vehicle-tab-contracts" aria-controls="vehicle-tabpanel" aria-selected="@(activeProfileTab == VehicleProfileTab.Contracts)" @onclick="() => activeProfileTab = VehicleProfileTab.Contracts" class="-mb-px border-b-2 pb-3 text-sm transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#E98200] @(activeProfileTab == VehicleProfileTab.Contracts ? "border-[#FF8C1A] font-semibold text-[#102344]" : "border-transparent text-[#738095] hover:text-[#102344]")">Mietverträge <span class="ml-1 font-normal text-[#738095]">@SelectedVehicle.Contracts.Count</span></button>
                    </div>

                    <div id="vehicle-tabpanel" role="tabpanel" aria-labelledby="@(activeProfileTab == VehicleProfileTab.Overview ? "vehicle-tab-overview" : "vehicle-tab-contracts")" class="pt-8">
                        @if (activeProfileTab == VehicleProfileTab.Overview)
                        {
                            <section class="pb-8">
                                <h3 class="text-sm font-semibold text-[#102344]">Fahrzeugdaten</h3>
                                <div class="mt-5 grid gap-x-10 gap-y-6 sm:grid-cols-2">
                                    <div><p class="text-xs text-[#738095]">Bezeichnung</p><p class="mt-1.5 text-sm text-[#213852]">@DisplayOrFallback(SelectedVehicle.Name)</p></div>
                                    <div><p class="text-xs text-[#738095]">Gattung</p><p class="mt-1.5 text-sm text-[#213852]">@DisplayOrFallback(SelectedVehicle.VehicleClass)</p></div>
                                    <div><p class="text-xs text-[#738095]">Inhaber</p>@ContactValue(SelectedVehicle.OwnerNumber, SelectedVehicle.Owner, "mt-1.5")</div>
                                    <div><p class="text-xs text-[#738095]">Fahrzeugnummer</p><p class="mt-1.5 text-sm text-[#213852]">@SelectedVehicle.Number</p></div>
                                    <div><p class="text-xs text-[#738095]">Mietverträge</p><p class="mt-1.5 text-sm text-[#213852]">@SelectedVehicle.Contracts.Count</p></div>
                                </div>
                            </section>

                            <section class="border-t border-[#E4E8EE] py-7">
                                <h3 class="text-sm font-semibold text-[#102344]">Aktuelle Vermietung</h3>
                                @if (currentContract is null)
                                {
                                    <p class="mt-4 text-sm leading-6 text-[#40536D]">Derzeit kein laufender Mietvertrag.</p>
                                }
                                else
                                {
                                    <div class="mt-5 grid gap-x-10 gap-y-6 sm:grid-cols-2">
                                        <div><p class="text-xs text-[#738095]">Mietvertrag</p><a class="mt-1.5 block break-words text-sm text-[#E98200] hover:text-[#BE6800]" href="@ContractLink(currentContract)" title="Mietvertrag öffnen">@currentContract.ContractNumber <span aria-hidden="true">›</span></a></div>
                                        <div><p class="text-xs text-[#738095]">Mieter</p>@ContactValue(currentContract.TenantNumber, currentContract.Tenant, "mt-1.5")</div>
                                        <div><p class="text-xs text-[#738095]">Fahrzeughalter</p>@ContactValue(currentContract.VehicleHolderNumber, currentContract.VehicleHolder, "mt-1.5")</div>
                                        <div><p class="text-xs text-[#738095]">Vertragszeitraum</p><p class="mt-1.5 text-sm text-[#213852]">@FormatPeriod(currentContract.ContractPeriodFrom, currentContract.ContractPeriodTo)</p></div>
                                    </div>
                                }
                            </section>
                        }
                        else if (SelectedVehicle.Contracts.Count == 0)
                        {
                            <p class="text-sm text-[#738095]">Keine Mietverträge zugeordnet.</p>
                        }
                        else
                        {
                            <div class="divide-y divide-[#E4E8EE]">
                                @foreach (var contract in SelectedVehicle.Contracts)
                                {
                                    <div @key="contract.Number" class="grid gap-x-10 gap-y-3 py-5 sm:grid-cols-[minmax(0,1.2fr)_minmax(0,1fr)_minmax(0,1fr)]">
                                        <div class="min-w-0">
                                            <div class="flex flex-wrap items-center gap-2">
                                                <a href="@ContractLink(contract)" title="Mietvertrag öffnen" class="break-words text-sm font-medium text-[#E98200] hover:text-[#BE6800] focus-visible:outline focus-visible:outline-2 focus-visible:outline-[#E98200]">@contract.ContractNumber <span aria-hidden="true">›</span></a>
                                                @if (contract.IsRunning)
                                                {
                                                    <span class="rounded-full bg-[#FFF3E0] px-2 py-0.5 text-[10px] text-[#9A5B00]">Laufend</span>
                                                }
                                                else if (!contract.IsActive)
                                                {
                                                    <span class="rounded-full bg-[#EEF0F3] px-2 py-0.5 text-[10px] text-[#58677D]">Inaktiv</span>
                                                }
                                            </div>
                                            <p class="mt-1 text-xs text-[#738095]">@FormatPeriod(contract.ContractPeriodFrom, contract.ContractPeriodTo)</p>
                                        </div>
                                        <div class="min-w-0"><p class="text-xs text-[#738095]">Mieter</p>@ContactValue(contract.TenantNumber, contract.Tenant, "mt-1 truncate")</div>
                                        <div class="min-w-0"><p class="text-xs text-[#738095]">Fahrzeughalter</p>@ContactValue(contract.VehicleHolderNumber, contract.VehicleHolder, "mt-1 truncate")</div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            }
            else
            {
                <div class="grid h-full min-h-64 flex-1 place-items-center rounded-[26px] border border-dashed border-white/15 text-sm text-white/50">Fahrzeug auswählen</div>
            }
        </main>
    </div>
}

@code {
    private IReadOnlyList<Vehicle> vehicles = [];
    private Vehicle? SelectedVehicle;
    private string searchTerm = string.Empty;
    private bool isLoading = true;
    private ElementReference vehicleList;
    private bool vehicleNavigationAttached;
    private VehicleStatusFilter statusFilter = VehicleStatusFilter.All;
    private VehicleProfileTab activeProfileTab = VehicleProfileTab.Overview;

    private enum VehicleStatusFilter
    {
        All,
        Rented,
        Available
    }

    private enum VehicleProfileTab
    {
        Overview,
        Contracts
    }

    private string StatusFilterLabel => statusFilter switch
    {
        VehicleStatusFilter.Rented => "Vermietete Fahrzeuge",
        VehicleStatusFilter.Available => "Verfügbare Fahrzeuge",
        _ => "Alle Fahrzeuge"
    };

    private IEnumerable<Vehicle> FilteredVehicles => vehicles.Where(vehicle =>
        MatchesStatusFilter(vehicle)
        && $"{vehicle.DisplayName} {vehicle.Number} {vehicle.Owner} {string.Join(" ", vehicle.Contracts.Select(contract => $"{contract.ContractNumber} {contract.Tenant} {contract.VehicleHolder}"))}"
            .Contains(searchTerm, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        vehicles = await VehicleService.GetVehiclesAsync();
        SelectedVehicle = vehicles.FirstOrDefault();
        isLoading = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!vehicleNavigationAttached && vehicles.Count > 0)
        {
            await JS.InvokeVoidAsync("northrailChat.attachContactNavigation", vehicleList);
            vehicleNavigationAttached = true;
        }
    }

    private void EnsureFilteredSelection()
    {
        var visibleVehicles = FilteredVehicles.ToList();
        if (visibleVehicles.Count == 0)
        {
            SelectedVehicle = null;
        }
        else if (!visibleVehicles.Any(vehicle => vehicle.Key == SelectedVehicle?.Key))
        {
            SelectedVehicle = visibleVehicles[0];
        }
    }

    private void SetStatusFilter(VehicleStatusFilter filter)
    {
        statusFilter = filter;
        EnsureFilteredSelection();
    }

    private bool MatchesStatusFilter(Vehicle vehicle) => statusFilter switch
    {
        VehicleStatusFilter.Rented => vehicle.CurrentContract is not null,
        VehicleStatusFilter.Available => vehicle.CurrentContract is null,
        _ => true
    };

    private async Task HandleSearchKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "ArrowDown" && FilteredVehicles.Any())
        {
            await JS.InvokeVoidAsync("northrailChat.focusFirstContact", vehicleList);
        }
    }

    private void SelectVehicle(Vehicle vehicle) => SelectedVehicle = vehicle;

    private static string Initials(Vehicle vehicle) =>
        string.Concat(vehicle.DisplayName.Split(' ', StringSplitOptions.RemoveEmptyEntries)
            .Take(2)
            .Select(part => char.ToUpperInvariant(part[0])));

    private static string ContractLink(VehicleContract contract) =>
        $"/mietvertraege?vertrag={contract.Number}";

    private static RenderFragment ContactValue(int? contactNumber, string name, string spacingClass) => __builder =>
    {
        if (contactNumber is { } number && !string.IsNullOrWhiteSpace(name))
        {
            <a href="/crm?kontakt=@number" title="Kontakt öffnen" class="@spacingClass block text-sm text-[#E98200] hover:text-[#BE6800]">@name <span aria-hidden="true">›</span></a>
        }
        else
        {
            <p class="@spacingClass text-sm text-[#213852]">@DisplayOrFallback(name)</p>
        }
    };

    private static string DisplayOrFallback(string value) =>
        string.IsNullOrWhiteSpace(value) ? "Nicht hinterlegt" : value;

    private static string FormatDate(DateTime? value) =>
        value?.ToString("dd.MM.yyyy") ?? "Nicht hinterlegt";

    private static string FormatPeriod(DateTime? from, DateTime? to) =>
        $"{FormatDate(from)} bis {FormatDate(to)}";
}
