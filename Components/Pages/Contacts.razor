@page "/"
@page "/crm"
@rendermode InteractiveServer
@using NorthrailCRM.Models
@using NorthrailCRM.Services
@using NorthrailCRM.Components.Shared
@using Microsoft.JSInterop
@inject ContactService ContactService
@inject IJSRuntime JS

<PageTitle>Kontakte | Northrail CRM</PageTitle>

@if (isLoading)
{
    <div class="grid min-h-screen place-items-center bg-[#0B2140] text-sm text-white/65">Kontakte werden geladen ...</div>
}
else
{
    <div class="grid min-h-screen bg-[#0B2140] text-white lg:h-screen lg:min-h-0 lg:overflow-hidden lg:grid-cols-[232px_350px_minmax(0,1fr)]">
        <WorkspaceSidebar ActivePage="contacts" />

        <section class="crm-contact-list max-h-[55vh] min-h-[45vh] overflow-y-auto border-b border-white/10 bg-[#102849] lg:h-screen lg:min-h-0 lg:max-h-screen lg:border-b-0 lg:border-r">
            <div class="sticky top-0 z-10 bg-[#102849]">
            <header class="flex items-center justify-between border-b border-white/10 px-6 py-6">
                <div>
                    <p class="text-xs font-medium uppercase tracking-[0.16em] text-[#FF9A2E]">CRM / Kontakte</p>
                    <h1 class="mt-1 text-xl font-semibold tracking-tight text-white">Kontakte <span class="ml-1 text-sm font-normal text-white/45">@contacts.Count</span></h1>
                </div>
            </header>

            <div class="border-b border-white/10 p-4">
                <label class="flex items-center gap-2.5 rounded-lg border border-white/15 bg-[#0B2140] px-3 py-2.5 focus-within:border-[#FF8C1A]">
                    <svg class="size-4 shrink-0 text-white/45" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m16 16 4 4"/></svg>
                    <input @bind="searchTerm" @bind:event="oninput" @bind:after="EnsureFilteredSelection" placeholder="Name, Firma oder E-Mail suchen" class="w-full bg-transparent text-sm text-white outline-none placeholder:text-white/40" />
                    <kbd class="hidden rounded border border-white/20 px-1.5 py-0.5 text-[10px] text-white/45 sm:inline">⌘ K</kbd>
                </label>
                <div class="mt-4 flex items-center justify-between text-xs">
                    <span class="font-medium text-white/70">Alle Kontakte</span>
                    <span class="text-white/45">@FilteredContacts.Count() Ergebnisse</span>
                </div>
            </div>
            </div>

            <div @ref="contactList" role="listbox" aria-label="Kontakte" class="divide-y divide-white/10">
                @foreach (var contact in FilteredContacts)
                {
                    var selected = SelectedContact?.Key == contact.Key;
                    <button @key="contact.Key" data-contact-key="@contact.Key" role="option" aria-selected="@selected" tabindex="@(selected ? 0 : -1)" @onclick="() => SelectContact(contact)" class="flex w-full items-start gap-3 px-5 py-4 text-left transition focus-visible:outline focus-visible:outline-2 focus-visible:outline-inset focus-visible:outline-[#FF8C1A] @(selected ? "bg-[#FF8C1A]/15" : "hover:bg-white/5")">
                        <span class="grid size-10 shrink-0 place-items-center rounded-full bg-white/10 text-xs font-semibold text-[#FFB45C]">@Initials(contact)</span>
                        <span class="min-w-0 flex-1">
                            <span class="flex items-center justify-between gap-2">
                                <span class="truncate text-sm font-medium text-white">@contact.DisplayName</span>
                                @if (selected)
                                {
                                    <span class="size-1.5 shrink-0 rounded-full bg-[#FF8C1A]"></span>
                                }
                            </span>
                            <span class="mt-1 block truncate text-xs text-white/65">@contact.Subtitle</span>
                        </span>
                    </button>
                }
                @if (!FilteredContacts.Any())
                {
                    <p class="px-5 py-10 text-center text-sm text-white/50">Keine Kontakte gefunden.</p>
                }
            </div>
        </section>

        <main class="min-w-0 bg-[#0B2140] p-5 sm:p-8 lg:min-h-0 lg:overflow-hidden">
            @if (SelectedContact is not null)
            {
                <div class="crm-contact-card mx-auto max-h-[calc(100vh-2.5rem)] max-w-4xl overflow-y-auto rounded-[26px] bg-white px-6 py-8 text-[#102344] shadow-xl shadow-black/10 sm:px-10 lg:max-h-full lg:px-14 lg:py-12">
                    <div class="flex flex-wrap items-start justify-between gap-5 border-b border-[#E4E8EE] pb-8">
                        <div class="flex items-center gap-5">
                            <span class="grid size-16 place-items-center rounded-2xl bg-[#0B2140] text-xl font-semibold text-[#FF9A2E]">@Initials(SelectedContact)</span>
                            <div>
                                <p class="text-xs font-medium uppercase tracking-[0.16em] text-[#E98200]">Kontaktprofil</p>
                                <h2 class="mt-1 text-2xl font-semibold tracking-tight text-[#102344]">@SelectedContact.DisplayName</h2>
                                <p class="mt-1 text-sm text-[#62728B]">@SelectedContact.Subtitle</p>
                            </div>
                        </div>
                    </div>

                    <section class="py-8">
                        <h3 class="text-sm font-semibold text-[#102344]">Kontaktinformationen</h3>
                        <div class="mt-5 grid gap-x-10 gap-y-6 sm:grid-cols-2">
                            <div><p class="text-xs text-[#738095]">E-Mail-Adresse</p><a class="mt-1.5 block break-all text-sm text-[#E98200] hover:text-[#BE6800]" href="mailto:@SelectedContact.Email">@SelectedContact.Email</a></div>
                            <div><p class="text-xs text-[#738095]">Telefon</p><a class="mt-1.5 block text-sm text-[#213852] hover:text-[#E98200]" href="tel:@SelectedContact.PhoneNumber">@SelectedContact.PhoneNumber</a></div>
                            <div><p class="text-xs text-[#738095]">Unternehmen</p><p class="mt-1.5 text-sm text-[#213852]">@SelectedContact.Company</p></div>
                            <div><p class="text-xs text-[#738095]">Kontaktart</p><p class="mt-1.5 text-sm text-[#213852]">@(SelectedContact.IsCustomer && SelectedContact.IsSupplier ? "Kunde · Lieferant" : SelectedContact.IsCustomer ? "Kunde" : SelectedContact.IsSupplier ? "Lieferant" : "Kontakt")</p></div>
                            <div class="sm:col-span-2"><p class="text-xs text-[#738095]">Anschrift</p><p class="mt-1.5 text-sm text-[#213852]">@SelectedContact.Address</p></div>
                        </div>
                    </section>

                    <section class="border-t border-[#E4E8EE] py-7">
                        <h3 class="text-sm font-semibold text-[#102344]">Personen <span class="ml-1 font-normal text-[#738095]">@SelectedContact.Persons.Count</span></h3>
                        @if (SelectedContact.Persons.Count == 0)
                        {
                            <p class="mt-4 text-sm text-[#738095]">Keine Personen zugeordnet.</p>
                        }
                        else
                        {
                            <div class="mt-4 divide-y divide-[#E4E8EE]">
                                @foreach (var person in SelectedContact.Persons)
                                {
                                    <div @key="person.Number" class="grid gap-2 py-4 sm:grid-cols-2">
                                        <div>
                                            <p class="text-sm font-medium text-[#213852]">@person.DisplayName</p>
                                            <p class="mt-1 text-xs text-[#738095]">@person.JobTitle</p>
                                        </div>
                                        <div class="text-sm sm:text-right">
                                            @if (!string.IsNullOrWhiteSpace(person.Email))
                                            {
                                                <a class="block break-all text-[#E98200] hover:text-[#BE6800]" href="mailto:@person.Email">@person.Email</a>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(person.PhoneNumber))
                                            {
                                                <a class="mt-1 block text-[#213852] hover:text-[#E98200]" href="tel:@person.PhoneNumber">@person.PhoneNumber</a>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </section>

                    <section class="border-t border-[#E4E8EE] py-7">
                        <div class="flex items-center justify-between">
                            <h3 class="text-sm font-semibold text-[#102344]">Notizen</h3>
                            <span class="rounded-full bg-[#EEF0F3] px-2.5 py-1 text-xs text-[#58677D]">Intern</span>
                        </div>
                        <p class="mt-4 whitespace-pre-wrap text-sm leading-6 text-[#40536D]">@(string.IsNullOrWhiteSpace(SelectedContact.Notes) ? "Noch keine Notizen zu diesem Kontakt." : SelectedContact.Notes)</p>
                    </section>

                    <section class="border-t border-[#E4E8EE] py-7">
                        <h3 class="text-sm font-semibold text-[#102344]">Letzte Aktivität</h3>
                        <div class="mt-5 flex gap-3">
                            <span class="mt-1.5 size-2 shrink-0 rounded-full bg-[#FF8C1A] ring-4 ring-[#FF8C1A]/15"></span>
                            <div><p class="text-sm text-[#213852]">Kontakt zum CRM hinzugefügt</p><p class="mt-1 text-xs text-[#738095]">Northrail Workspace</p></div>
                        </div>
                    </section>
                </div>
            }
        </main>
    </div>
}

@code {
    private IReadOnlyList<Contact> contacts = [];
    private Contact? SelectedContact;
    private string searchTerm = string.Empty;
    private bool isLoading = true;
    private ElementReference contactList;
    private bool contactNavigationAttached;

    private IEnumerable<Contact> FilteredContacts => contacts.Where(contact =>
        $"{contact.DisplayName} {contact.Email} {contact.PhoneNumber} {contact.Address} {string.Join(" ", contact.Persons.Select(person => $"{person.DisplayName} {person.JobTitle} {person.Email}"))}"
            .Contains(searchTerm, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        contacts = await ContactService.GetContactsAsync();
        SelectedContact = contacts.FirstOrDefault();
        isLoading = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!contactNavigationAttached && contacts.Count > 0)
        {
            await JS.InvokeVoidAsync("northrailChat.attachContactNavigation", contactList);
            contactNavigationAttached = true;
        }
    }

    private void EnsureFilteredSelection()
    {
        var visibleContacts = FilteredContacts.ToList();
        if (visibleContacts.Count > 0 && !visibleContacts.Any(contact => contact.Key == SelectedContact?.Key))
        {
            SelectedContact = visibleContacts[0];
        }
    }

    private void SelectContact(Contact contact) => SelectedContact = contact;

    private static string Initials(Contact contact) =>
        string.Concat(contact.DisplayName.Split(' ', StringSplitOptions.RemoveEmptyEntries)
            .Take(2)
            .Select(part => char.ToUpperInvariant(part[0])));
}