@using NorthrailCRM.Services
@inject ChatMarkdownRenderer MarkdownRenderer

<div class="chat-markdown pl-9 text-sm leading-6 text-[#213852]">
    @((MarkupString)MarkdownRenderer.ToSafeHtml(Markdown, Attachments))
    @if (Attachments.Count > 0)
    {
        <div class="mt-3 flex flex-wrap gap-2">
            @foreach (var attachment in Attachments)
            {
                <a href="@attachment.DownloadUrl" download="@attachment.FileName" class="inline-flex max-w-full items-center gap-2 rounded-lg border border-[#D9DFE7] bg-[#F7F8FA] px-3 py-2 text-xs font-medium text-[#BE6800] transition-colors hover:border-[#FF8C1A] hover:bg-[#FFF5E8]" title="@attachment.FileName">
                    <svg class="size-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 3v11m0 0 4-4m-4 4-4-4M5 17v3h14v-3" /></svg>
                    <span class="truncate">@attachment.FileName</span>
                    <span class="shrink-0">Herunterladen</span>
                </a>
            }
        </div>
    }
</div>

@code {
    [Parameter]
    public string Markdown { get; set; } = string.Empty;

    [Parameter]
    public IReadOnlyList<AgentChatAttachment> Attachments { get; set; } = [];
}