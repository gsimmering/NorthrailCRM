<aside class="border-b border-white/10 bg-[#0B2140] px-4 py-4 lg:flex lg:flex-col lg:border-b-0 lg:border-r lg:px-5 lg:py-7">
    <a href="/" class="mb-4 flex items-center gap-3 text-lg font-semibold tracking-wide text-white lg:mb-12">
        <img src="/images/northrail-logo.svg" alt="Northrail" class="h-5 w-auto" />
    </a>
    <p class="mb-3 hidden px-3 text-[10px] font-bold uppercase tracking-[0.18em] text-white/45 lg:block">Workspace</p>
    <nav class="flex flex-wrap gap-1 lg:block lg:space-y-1">
        <a href="/crm" aria-current="@(ActivePage == "contacts" ? "page" : null)" class="flex items-center gap-3 rounded-full px-3 py-2.5 text-sm transition-colors duration-150 ease-in-out focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#FF8C1A] motion-reduce:transition-none @(ActivePage == "contacts" ? "bg-[#FF8C1A] font-semibold text-[#0B2140] hover:bg-[#FF9A2E]" : "text-white/60 hover:bg-white/5 hover:text-white")">
            <span aria-hidden="true">◈</span> Kontakte
        </a>
        <a href="/chat" aria-current="@(ActivePage == "chat" ? "page" : null)" class="flex items-center gap-3 rounded-full px-3 py-2.5 text-sm transition-colors duration-150 ease-in-out focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#FF8C1A] motion-reduce:transition-none @(ActivePage == "chat" ? "bg-[#FF8C1A] font-semibold text-[#0B2140] hover:bg-[#FF9A2E]" : "text-white/60 hover:bg-white/5 hover:text-white")">
            <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M20 11.5a7.5 7.5 0 0 1-7.5 7.5 8 8 0 0 1-3.6-.85L4 20l1.55-4.1A7.5 7.5 0 1 1 20 11.5Z"/><path d="M8.5 11.5h.01m3.49 0h.01m3.49 0h.01" stroke-width="2.6" stroke-linecap="round"/></svg>
            Agent-Chat
        </a>
        <span class="hidden items-center gap-3 rounded-lg px-3 py-2.5 text-sm text-white/40 lg:flex"><span aria-hidden="true">▤</span> Unternehmen</span>
        <span class="hidden items-center gap-3 rounded-lg px-3 py-2.5 text-sm text-white/40 lg:flex"><span aria-hidden="true">◷</span> Aktivitäten</span>
    </nav>
    <div class="mt-auto hidden items-center gap-3 border-t border-white/10 pt-5 lg:flex">
        <span class="grid size-9 place-items-center rounded-full bg-white/10 text-xs font-semibold text-white/80">NW</span>
        <div class="min-w-0">
            <p class="truncate text-sm font-medium text-white/90">Nora Wagner</p>
            <p class="text-xs text-white/45">Administratorin</p>
        </div>
        <span class="ml-auto text-white/50" aria-hidden="true">···</span>
    </div>
</aside>

@code {
    [Parameter]
    public string ActivePage { get; set; } = "contacts";
}